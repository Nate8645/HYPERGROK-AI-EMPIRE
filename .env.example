# HYPERGROK AI EMPIRE — phase 1 example configuration.
# Copy to .env if you want local overrides. Do not put private keys,
# seed phrases, exchange API keys, or wallet secrets in this file.
# Phase 1 has no signing and no live order transmission.

HYPERGROK_ENVIRONMENT=development
HYPERGROK_LOG_LEVEL=INFO
HYPERGROK_LOG_JSON=true
HYPERGROK_DATABASE_URL=sqlite:///./data/hypergrok.db

# Paper account. Defaults match the desk brief: 20 CHF, no leverage.
HYPERGROK_ACCOUNT_CURRENCY=CHF
HYPERGROK_STARTING_CAPITAL=20
HYPERGROK_MAX_LEVERAGE=1
HYPERGROK_MAX_PLANNED_RISK_FRACTION=0.01
HYPERGROK_MAX_DAILY_LOSS_FRACTION=0.03
HYPERGROK_MAX_OPEN_POSITIONS=1
HYPERGROK_MAX_NEW_ENTRIES_PER_DAY=2
HYPERGROK_HYPERLIQUID_RESERVE_FRACTION=0.20

# Hyperliquid's documented minimum order value used by this desk.
# Notional is checked in this currency. If the paper account is CHF,
# the caller must supply an explicit USD rate. The desk does not invent FX.
HYPERGROK_MIN_ORDER_NOTIONAL=10
HYPERGROK_MIN_ORDER_NOTIONAL_CURRENCY=USD

# Planning assumptions for round-trip costs, in basis points.
# These are desk assumptions, not a live fee schedule pulled from an exchange.
HYPERGROK_DEFAULT_FEE_BPS_ROUND_TRIP=10
HYPERGROK_DEFAULT_SLIPPAGE_BPS_ROUND_TRIP=10
HYPERGROK_DEFAULT_STOP_FRACTION=0.005
HYPERGROK_MAX_MARKET_DATA_AGE_SECONDS=5
HYPERGROK_WIDE_SPREAD_BPS=50
HYPERGROK_IMBALANCE_THRESHOLD=0.20

# Public read-only market data. No credentials.
HYPERGROK_HYPERLIQUID_INFO_URL=https://api.hyperliquid.xyz/info
HYPERGROK_HYPERLIQUID_INFO_TIMEOUT_SECONDS=10

# Live trading is off. Coinbase spot still needs every flag below, an allowlist,
# a capital cap above 0, and a per-order approval token. Leave the key fields empty.
LIVE_TRADING_ENABLED=false
COINBASE_LIVE_ENABLED=false
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=
COINBASE_API_KEY_FILE=
COINBASE_PRODUCT_ALLOWLIST=
COINBASE_MAX_CAPITAL=0
# Optional explicit CHF per USD rate. Both the rate and the timestamp are required.
# The desk does not invent a rate or a timestamp. Do not put a live key in this file.
# HYPERGROK_FX_USD_PER_CHF=
# HYPERGROK_FX_AS_OF=
# HYPERGROK_FX_SOURCE=explicit_config
# HYPERGROK_MAX_FX_AGE_SECONDS=300
